{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/posts",
      "methods": ["GET", "POST", "PUT"],
      "dest": "server.js"
    },
    {
      "src": "/reels",
      "methods": ["GET", "POST"],
      "dest": "server.js"
    },
    {
      "src": "/reports",
      "methods": ["GET", "POST"],
      "dest": "server.js"
    },
    {
      "src": "/submit-form",
      "methods": ["POST"],
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
